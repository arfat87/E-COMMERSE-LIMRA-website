{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/admin-login", "dest": "/admin-login.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/table/qr-admin", "dest": "/table/qr-admin.html" },
    { "src": "/table", "dest": "/table/index.html" },
    { "src": "/stock-manager", "dest": "/stock-manager/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
