{
  "name": "limra-restaurant-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "deploy:insforge": "npm run build && node scripts/deploy.mjs",
    "migrate:supabase": "node scripts/migrate-to-supabase.mjs",
    "start": "npm run start --prefix backend",
    "server": "npm run start --prefix backend"
  },
  "devDependencies": {
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@insforge/sdk": "^1.5.2",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.3.0",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "tailwindcss": "^4.3.0"
  }
}
