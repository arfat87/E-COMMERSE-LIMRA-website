{
  "name": "limra-restaurant-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.limra.pos",
    "productName": "Limra Restaurant POS",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "icon": "electron/icon.png"
    }
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend && node -e \"import('fs').then(fs => fs.cpSync('frontend/dist', 'dist', { recursive: true }))\"",
    "deploy:insforge": "npm run build && node scripts/deploy.mjs",
    "migrate:supabase": "node scripts/migrate-to-supabase.mjs",
    "start": "npm run start --prefix backend",
    "server": "npm run start --prefix backend",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "desktop:dev": "npm run build && electron electron/main.cjs",
    "desktop:dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@insforge/sdk": "^1.5.2",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.3.0",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "tailwindcss": "^4.3.0"
  }
}
