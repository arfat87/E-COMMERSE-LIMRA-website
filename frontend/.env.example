# ==============================================================
# LIMRA RESTAURANT — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Copy this file to frontend/.env for local development:
#   cp frontend/.env.example frontend/.env
#
# NOTE: All variables prefixed with VITE_ are embedded into public
# client JavaScript bundles at build time. NEVER put private server
# keys (service_role, razorpay secret, twilio auth) in this file!
# ==============================================================

# Supabase Public Keys (RLS Enforced)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Razorpay Public Gateway Key (Client Checkout Modal)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# EmailJS Public Client Configuration (Optional)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
