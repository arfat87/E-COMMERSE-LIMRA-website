# ==============================================================
# LIMRA RESTAURANT — MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit .env or any file containing real secrets to Git.
# ==============================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=development

# --------------------------------------------------------------
# Supabase PostgreSQL Database & Auth (Server & Client)
# --------------------------------------------------------------
# Backend Server Access (Server-Only):
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Privileged service role key — NEVER expose to frontend or git:
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Frontend Client Access (Public / Browser Safe):
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy BaaS compatibility aliases:
VITE_INSFORGE_URL=https://<your-project-ref>.supabase.co
VITE_INSFORGE_ANON_KEY=eyJhbGciOi...

# --------------------------------------------------------------
# Razorpay Payment Gateway
# --------------------------------------------------------------
# Public Key ID (Safe for client browser):
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Server-Only Private Secrets — NEVER expose to frontend:
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
ALLOW_PAYMENT_SIMULATION=false

# --------------------------------------------------------------
# SMS / WhatsApp Gateways (Optional)
# --------------------------------------------------------------
FAST2SMS_API_KEY=your_fast2sms_api_key_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_OTP_TEMPLATE=limra_login_otp

# Twilio (Optional International SMS):
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# --------------------------------------------------------------
# Client-Safe Email Notifications (EmailJS)
# --------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
