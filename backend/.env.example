# ==============================================================
# LIMRA RESTAURANT — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Copy this file to backend/.env for local development:
#   cp backend/.env.example backend/.env
#
# DO NOT commit backend/.env to Git.
# ==============================================================

PORT=3000
NODE_ENV=development

# --------------------------------------------------------------
# Supabase PostgreSQL Configuration
# --------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Privileged service role key — NEVER expose to frontend or git:
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --------------------------------------------------------------
# Razorpay Payment Gateway Credentials
# --------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
ALLOW_PAYMENT_SIMULATION=false

# --------------------------------------------------------------
# SMS / WhatsApp Gateways (Optional)
# --------------------------------------------------------------
FAST2SMS_API_KEY=your_fast2sms_api_key_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_OTP_TEMPLATE=limra_login_otp

# Twilio (Optional International SMS):
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
