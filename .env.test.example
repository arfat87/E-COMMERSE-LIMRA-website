# ==============================================================
# LIMRA RESTAURANT — AUTOMATED TESTING ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Copy this file to .env.test for local test execution:
#   cp .env.test.example .env.test
#
# Automated tests will NEVER execute on production environments.
# ==============================================================

NODE_ENV=test
LIMRA_TEST_ENV=true
PORT=3001

# --------------------------------------------------------------
# ISOLATED DEVELOPMENT / TESTING SUPABASE DATABASE (OPTIONAL)
# --------------------------------------------------------------
# Configure a separate Supabase project for local development & testing.
# When left unconfigured, automated tests run in the built-in
# Isolated Test Database Sandbox with GUARANTEED ZERO WRITES to production!
# --------------------------------------------------------------
# Example development Supabase project:
# DEV_SUPABASE_URL=https://<your-dev-project-ref>.supabase.co
# DEV_SUPABASE_ANON_KEY=eyJhbGciOi...
# DEV_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Aliases:
# SUPABASE_TEST_URL=https://<your-dev-project-ref>.supabase.co
# SUPABASE_TEST_ANON_KEY=eyJhbGciOi...
# SUPABASE_TEST_SERVICE_ROLE_KEY=eyJhbGciOi...

# --------------------------------------------------------------
# TEST GATEWAY CONFIGURATION
# --------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=test_razorpay_secret_key_mock
ALLOW_PAYMENT_SIMULATION=false
